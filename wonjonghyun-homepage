    .topic-card h3 { margin: 1px 0 7px; color: var(--navy); font-size: 18px; }
    .topic-card p { margin: 0; color: var(--muted); font-size: 13px; }

    .cases-intro { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 32px; }
    .cases-intro .section-head { margin: 0; }
    .case-status { flex: 0 0 auto; padding: 8px 13px; border-radius: 999px; background: #edf4f3; color: var(--mint-deep); font-size: 11px; font-weight: 800; }
    .case-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px; }
    .case-card { position: relative; padding: 28px; border: 1px solid var(--line); border-radius: var(--radius); background: white; box-shadow: 0 10px 30px rgba(16,42,67,.045); }
    .case-card-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .case-type { color: var(--mint-deep); font-size: 11px; font-weight: 900; letter-spacing: .1em; }
    .case-source { padding: 6px 9px; border-radius: 999px; color: #78684f; background: #f3eee6; font-size: 10px; font-weight: 800; white-space: nowrap; }
    .case-amount { margin: 19px 0 5px; color: var(--navy); font-size: clamp(31px,4vw,43px); font-weight: 900; line-height: 1.1; letter-spacing: -.06em; }
