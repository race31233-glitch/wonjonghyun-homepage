    .about-copy p { color: #c5d2dc; font-size: 15px; }
    .about-points { display: grid; grid-template-columns: repeat(2,1fr); gap: 12px 24px; margin-top: 25px; }
    .about-points div { display: flex; gap: 9px; color: #e0e9ef; font-size: 13px; }
    .about-points b { color: var(--mint); }

    .contact { padding: 86px 0; background: var(--mint); }
    .contact-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; }
    .contact h2 { margin: 0 0 8px; color: var(--navy); font-size: clamp(30px,4vw,44px); line-height: 1.2; letter-spacing: -.055em; }
    .contact p { margin: 0; color: #42685f; font-size: 14px; }
    .contact-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .contact .btn-primary { background: var(--navy); color: white; }
    .contact .btn-outline { color: var(--navy); border-color: rgba(16,42,67,.35); }

    footer { padding: 34px 0 100px; background: #f7f9fa; }
    .footer-top { display: flex; justify-content: space-between; gap: 24px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
    .footer-brand { color: var(--navy); font-weight: 900; }
    .footer-meta { color: var(--muted); font-size: 12px; text-align: right; }
    .disclaimer { max-width: 900px; margin-top: 22px; color: #7a8996; font-size: 11px; line-height: 1.8; }
    .copyright { margin-top: 18px; color: #9aa6af; font-size: 10px; }
