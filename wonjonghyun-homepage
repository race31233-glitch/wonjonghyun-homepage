      .nav-links.open { display: flex; }
      .nav-links a { padding: 12px 0; }
      .nav-call { text-align: center; margin-top: 8px; }
      .hero { padding: 70px 0 68px; }
      .hero-grid { grid-template-columns: 1fr; gap: 38px; }
      .hero-portrait { justify-self: center; width: min(100%, 420px); }
      .hero-portrait-note { text-align: center; }
      .trust-grid { grid-template-columns: 1fr; }
      .trust-item, .trust-item:first-child { padding: 18px 0; border-right: 0; border-bottom: 1px solid #d7e4df; }
      .trust-item:last-child { border-bottom: 0; }
      .reason-grid { grid-template-columns: repeat(2,1fr); }
      .process { grid-template-columns: repeat(2,1fr); }
      .process-step:nth-child(2) { border-right: 0; }
      .process-step:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
      .about-grid { grid-template-columns: 1fr; gap: 34px; }
      .about-card { max-width: 430px; }
      .contact-inner { align-items: flex-start; flex-direction: column; }
      .footer-top { flex-direction: column; }
      .footer-meta { text-align: left; }
      .mobile-call { position: fixed; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; z-index: 40; left: 14px; right: 14px; bottom: 12px; }
      .mobile-call a { display: flex; align-items: center; justify-content: center; min-height: 52px; border-radius: 999px; color: white; background: var(--navy); box-shadow: 0 12px 30px rgba(16,42,67,.25); font-size: 13px; font-weight: 900; }
      .mobile-call a.mobile-kakao { color: #191919; background: #FEE500; }
    }
    @media (max-width: 560px) {
      .wrap { width: calc(100% - 32px); }
      .hero h1 { font-size: 43px; }
      .hero-copy { font-size: 15px; }
      .hero-panel { padding: 22px; }
      .reason-grid, .topic-grid { grid-template-columns: 1fr; }
      .reason-card { min-height: 0; }
      .process-step { padding: 22px 17px; }
      .process-step h3 { font-size: 16px; }
      .process-step p { font-size: 12px; }
      .cases-intro { align-items: flex-start; flex-direction: column; }
      .case-grid { grid-template-columns: 1fr; }
      .case-card { padding: 23px; }
      .case-amount { font-size: 36px; }
      .about-points { grid-template-columns: 1fr; }
      .contact { padding: 68px 0; }
      .contact-actions { width: 100%; }
      .contact-actions .btn { flex: 1 1 100%; }
      footer { padding-bottom: 100px; }
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *:before, *:after { transition: none !important; } }
  </style>
