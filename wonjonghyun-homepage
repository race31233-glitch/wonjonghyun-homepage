    .process-step h3 { margin: 22px 0 8px; color: var(--navy); font-size: 18px; }
    .process-step p { margin: 0; color: var(--muted); font-size: 13px; }

    .topic-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 16px; }
    .topic-card { display: flex; gap: 18px; align-items: flex-start; min-height: 145px; padding: 25px; background: white; border: 1px solid var(--line); border-radius: var(--radius); }
