    .profile-item { display: flex; justify-content: space-between; gap: 18px; font-size: 13px; }
    .profile-item span { color: #aebfcb; }
    .profile-item b { text-align: right; font-weight: 700; }
    .hero-note { margin: 20px 0 0; color: #aebfcb; font-size: 11px; }

